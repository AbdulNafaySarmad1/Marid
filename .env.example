# Copy values to a local secret store or untracked .env file for dev-minimal.
MARID_DB_OWNER_PASSWORD=replace-with-long-random-value
MARID_DB_APP_PASSWORD=replace-with-different-long-random-value
MARID_KEYCLOAK_ADMIN_PASSWORD=replace-with-another-long-random-value
MARID_OIDC_AUTHORITY=http://localhost:8080/realms/marid-dev
MARID_OIDC_AUDIENCE=marid-api
# In production, list only the exact proxy IPs that connect to the API.
MARID_TRUSTED_PROXY_IPS=127.0.0.1
MARID_HSTS_ENABLED=false
TURNSTILE_ENABLED=false
