{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.marid.local/response-proposal/v1",
  "title": "MARID response proposal request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability", "resourceId", "parameters", "eventIds"],
  "properties": {
    "capability": {"type": "string", "pattern": "^[a-z0-9._]{3,160}$"},
    "resourceId": {"type": "string", "minLength": 1, "maxLength": 300},
    "parameters": {"type": "object"},
    "eventIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uuid"}
    }
  }
}
