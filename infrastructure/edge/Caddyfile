{
    # Caddy and the API share a private network namespace; the API is not
    # published on a public host port. Keep Caddy's data directory persistent.
    on_demand_tls {
        ask http://127.0.0.1:8080/internal/tls/allow
    }
}

https:// {
    tls {
        on_demand
    }

    @private path /internal/*
    respond @private 404

    reverse_proxy 127.0.0.1:8080
}
